// Static site served by Cloudflare Workers. Everything in public/ is uploaded.
// All audio goes through src/worker.js first: Range support for iPhone and seeking (+15 s).
{
  "name": "running-cadence",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "cadence.matmerten.com", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/generated/*", "/music/*", "/free/*", "/cadence/*"]
  }
}
